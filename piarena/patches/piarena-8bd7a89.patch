+# piarena-eval: same file as upstream, with two changes marked piarena-eval.
+# 1. `aicordon_api` is registered next to the built-in defenses.
+# 2. every other defense is imported inside try/except ImportError: upstream pulls fastchat, vllm
+#    and the rest of the zoo at import time, and this harness needs only `none` and `aicordon_api`.
+#    A defense whose dependencies are absent simply does not register - nothing else changes.
 from .base import BaseDefense
 from ..registry import DEFENSE_REGISTRY
 
 # Import all defense modules to trigger @register_defense decorators
 from . import defense_none  # noqa: F401
-from .secalign import defense_secalign  # noqa: F401
-from .pisanitizer import defense_pisanitizer  # noqa: F401
-from .datasentinel import defense_datasentinel  # noqa: F401
-from .attentiontracker import defense_attentiontracker  # noqa: F401
-from .promptguard import defense_promptguard  # noqa: F401
-from .promptlocate import defense_promptlocate  # noqa: F401
-from .promptarmor import defense_promptarmor  # noqa: F401
-from .datafilter import defense_datafilter  # noqa: F401
-from .piguard import defense_piguard  # noqa: F401
+from . import defense_aicordon_api  # noqa: F401  piarena-eval
+
+_OPTIONAL = []  # piarena-eval: defenses whose dependencies are not installed here
+for _name in ("secalign.defense_secalign", "pisanitizer.defense_pisanitizer",
+              "datasentinel.defense_datasentinel", "attentiontracker.defense_attentiontracker",
+              "promptguard.defense_promptguard", "promptlocate.defense_promptlocate",
+              "promptarmor.defense_promptarmor", "datafilter.defense_datafilter",
+              "piguard.defense_piguard"):
+    try:
+        __import__(f"{__name__}.{_name}")
+    except ImportError as _exc:      # piarena-eval
+        _OPTIONAL.append(f"{_name.split('.')[0]} ({_exc.name})")
+if _OPTIONAL:
+    print("[piarena-eval] defenses not available here: " + ", ".join(_OPTIONAL), flush=True)
 
 
 # Registry is auto-populated by @register_defense decorators
